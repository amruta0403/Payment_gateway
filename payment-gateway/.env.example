# ═══════════════════════════════════════════════════════════════════════════════
# Payment Gateway — Environment Variables
# Target: Oracle Cloud ARM A1 (Ubuntu 22.04, 4 CPU, 24 GB RAM)
#
# Copy to .env and fill in all REQUIRED values before running `make init`.
# Never commit .env to version control.
#
# Generate random secrets:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
#   python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# ═══════════════════════════════════════════════════════════════════════════════

# ─── Environment ──────────────────────────────────────────────────────────────
ENVIRONMENT=development          # development | staging | production
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
DEBUG=false                      # true only in development (enables /docs)

# ─── Domain & TLS ─────────────────────────────────────────────────────────────
# REQUIRED for production. All service subdomains are derived from this.
#   api.${DOMAIN}       — public API gateway
#   auth.${DOMAIN}      — Keycloak
#   monitor.${DOMAIN}   — Grafana
#   secrets.${DOMAIN}   — Infisical
#   errors.${DOMAIN}    — GlitchTip
#   traefik.${DOMAIN}   — Traefik dashboard
DOMAIN=payments.example.com
ACME_EMAIL=ops@example.com       # Let's Encrypt registration email

# Basic-auth for Traefik dashboard
# Generate: htpasswd -nb admin yourpassword
TRAEFIK_DASHBOARD_USERS=admin:$$apr1$$REPLACE_ME$$HASHED_PASSWORD_HERE

# ─── PostgreSQL (main) ────────────────────────────────────────────────────────
POSTGRES_USER=pguser
POSTGRES_PASSWORD=CHANGE_ME_STRONG_PASSWORD_HERE
POSTGRES_DB=payment_db

# Async SQLAlchemy URL (used by FastAPI services)
DATABASE_URL=postgresql+asyncpg://pguser:CHANGE_ME_STRONG_PASSWORD_HERE@postgres-main:5432/payment_db

# ─── PostgreSQL (CDE vault — PCI-isolated) ───────────────────────────────────
VAULT_POSTGRES_USER=vault_user
VAULT_POSTGRES_PASSWORD=CHANGE_ME_VAULT_PASSWORD_HERE
VAULT_POSTGRES_DB=vault_db

# Async URL for card-vault-service
VAULT_DATABASE_URL=postgresql+asyncpg://vault_user:CHANGE_ME_VAULT_PASSWORD_HERE@postgres-vault:5432/vault_db

# CDE subnet — card-vault InternalServiceAuthMiddleware checks this
# Set to the cde_network Docker subnet (default: 172.21.0.0/24)
CDE_NETWORK_SUBNET=172.21.0.0/24
SKIP_SUBNET_CHECK=false          # true only in development

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
# DB allocation:
#   0 — application (idempotency, rate-limit, velocity, cache, locks)
#   1 — Celery broker
#   2 — Celery results
#   3 — Infisical
#   4 — GlitchTip

# ─── Kafka / Redpanda ─────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

# ─── Keycloak IAM ─────────────────────────────────────────────────────────────
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_KEYCLOAK_ADMIN_PASSWORD

KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=payment-gateway
KEYCLOAK_CLIENT_ID=payment-backend
KEYCLOAK_CLIENT_SECRET=CHANGE_ME_KEYCLOAK_CLIENT_SECRET

# ─── Infisical (secrets management) ──────────────────────────────────────────
# Token used by services to pull secrets at startup
INFISICAL_TOKEN=st.xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
INFISICAL_SITE_URL=https://secrets.payments.example.com

# Infisical server own secrets (used by the Infisical container itself)
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
INFISICAL_ENCRYPTION_KEY=CHANGE_ME_32_CHAR_INFISICAL_ENCRYPTION_KEY_HERE!
INFISICAL_AUTH_SECRET=CHANGE_ME_INFISICAL_AUTH_SECRET_HERE_MINIMUM_32_CHARS

# ─── Internal service authentication ─────────────────────────────────────────
# X-Service-Token header required for internal service-to-service calls
# (payment-service → card-vault-service, etc.)
INTERNAL_SERVICE_TOKEN=CHANGE_ME_INTERNAL_SERVICE_TOKEN_64_CHARS_MINIMUM

# ─── Encryption keys ──────────────────────────────────────────────────────────
# AES-256-GCM field encryption for PAN, VPA, account numbers, etc.
# Generate: python -c "import os, base64; print(base64.b64encode(os.urandom(32)).decode())"
# CRITICAL: Back these up — losing them means losing all encrypted data permanently.
CARD_ENCRYPTION_KEY_VERSION=1
CARD_ENCRYPTION_KEY_V1=REPLACE_WITH_BASE64_ENCODED_32_BYTE_AES_KEY=
# CARD_ENCRYPTION_KEY_V2=  # Uncomment during key rotation

# Card vault multi-key config
CARD_VAULT_KEY_VERSION=1
CARD_VAULT_ENCRYPTION_KEY_V1=REPLACE_WITH_BASE64_ENCODED_32_BYTE_AES_KEY_FOR_VAULT=

# ─── Acquirer / Payment Gateway ───────────────────────────────────────────────
ACQUIRER_MODE=mock               # mock | razorpay

# Razorpay payment processing
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx

# Razorpay X (for settlement payouts)
RAZORPAY_X_KEY_ID=rzpx_test_xxxxxxxxxxxx
RAZORPAY_X_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_X_ACCOUNT=XXXXXXXXXXXXXXXXXX    # Razorpay X source account number
PAYOUT_PROVIDER=mock                     # mock | razorpay

# ─── UPI / NPCI ───────────────────────────────────────────────────────────────
NPCI_CLIENT_MODE=mock            # mock | live
GATEWAY_VPA=merchant@hdfc        # Default payee VPA for collect requests
NPCI_CALLBACK_SECRET=CHANGE_ME_NPCI_HMAC_SECRET_HERE
UPI_COLLECT_EXPIRY_SECONDS=300

# ─── Email / SMTP ─────────────────────────────────────────────────────────────
# Used by: notification-service, infisical, glitchtip
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM_EMAIL=noreply@payments.example.com
SMTP_FROM_NAME=Payment Gateway

# Alternative: Resend API (preferred for transactional email)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── SMS ──────────────────────────────────────────────────────────────────────
# Supported: fast2sms (India), twilio, msg91
SMS_PROVIDER=fast2sms
FAST2SMS_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMS_SENDER_ID=PAYGTW

# ─── Storage (KYC documents) ──────────────────────────────────────────────────
# AWS S3 or Cloudflare R2 (free tier: 10 GB storage + 10M ops/month)
AWS_REGION=ap-south-1
S3_KYC_BUCKET=payment-kyc-docs
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY

# For Cloudflare R2: set endpoint URL (leave empty for AWS S3)
# S3_ENDPOINT_URL=https://xxxxxxxx.r2.cloudflarestorage.com

# ─── Security ─────────────────────────────────────────────────────────────────
# CORS: comma-separated allowed origins for browser requests
CORS_ORIGINS=https://dashboard.payments.example.com,https://checkout.payments.example.com

# Secret for webhook HMAC signing
WEBHOOK_SECRET_SALT=CHANGE_ME_WEBHOOK_SECRET_SALT_HERE

# ─── Monitoring ───────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_GRAFANA_ADMIN_PASSWORD

# GlitchTip (open-source Sentry) — obtain DSN after setup
GLITCHTIP_DSN=https://xxxxxxxxxxxxxxxxxxxx@errors.payments.example.com/1
GLITCHTIP_SECRET_KEY=CHANGE_ME_GLITCHTIP_DJANGO_SECRET_KEY_HERE_50_CHARS

# ─── Service URLs (internal Docker DNS) ──────────────────────────────────────
PAYMENT_SERVICE_URL=http://payment-service:8010
CARD_VAULT_SERVICE_URL=http://card-vault-service:8011
MERCHANT_SERVICE_URL=http://merchant-service:8012
FRAUD_SERVICE_URL=http://fraud-service:8013
UPI_SERVICE_URL=http://upi-service:8014
SETTLEMENT_SERVICE_URL=http://settlement-service:8015
REFUND_SERVICE_URL=http://refund-service:8016
NOTIFICATION_SERVICE_URL=http://notification-service:8017
KYC_SERVICE_URL=http://kyc-service:8018
NETBANKING_SERVICE_URL=http://netbanking-service:8019
TRANSACTION_SERVICE_URL=http://transaction-service:8020
WEBHOOK_SERVICE_URL=http://webhook-service:8021
REPORTING_SERVICE_URL=http://reporting-service:8022
AUDIT_SERVICE_URL=http://audit-service:8024

# ─── Celery ───────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Settlement schedule (UTC)
SETTLEMENT_CUTOFF_HOUR_UTC=17    # 17:30 UTC = 23:00 IST

# ─── Oracle Cloud ARM A1 specific ─────────────────────────────────────────────
# Free tier: 4 OCPUs (ARM), 24 GB RAM, 200 GB block storage
# Recommended resource allocation:
#   postgres-main:     4 GB
#   redis:             2 GB
#   redpanda:          512 MB
#   keycloak:          1 GB
#   14 FastAPI svcs:   ~200 MB each = 2.8 GB total
#   Celery workers:    ~512 MB each = 1 GB
#   Monitoring stack:  1.5 GB (prometheus + grafana)
#   Infisical:         512 MB
#   GlitchTip:         512 MB
#   OS + overhead:     4 GB
#   Buffer:            ~6 GB
