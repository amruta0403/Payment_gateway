# ─── Environment ─────────────────────────────────────────────────────────────
ENVIRONMENT=development          # dev | staging | prod
LOG_LEVEL=INFO                   # DEBUG | INFO | WARNING | ERROR
DEBUG=false

# ─── Databases ───────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://pguser:pgpass@postgres-main:5432/payment_db
VAULT_DATABASE_URL=postgresql+asyncpg://vault_user:vault_pass@postgres-vault:5432/vault_db

POSTGRES_USER=pguser
POSTGRES_PASSWORD=pgpass
POSTGRES_DB=payment_db

VAULT_POSTGRES_USER=vault_user
VAULT_POSTGRES_PASSWORD=vault_pass
VAULT_POSTGRES_DB=vault_db

# ─── Redis ───────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_PASSWORD=

# ─── Kafka / Redpanda ────────────────────────────────────────────────────────
KAFKA_BOOTSTRAP_SERVERS=redpanda:9092

# ─── Keycloak ────────────────────────────────────────────────────────────────
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=payment-gateway
KEYCLOAK_CLIENT_ID=payment-backend
KEYCLOAK_CLIENT_SECRET=change-me-secret
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin

# ─── Infisical (secrets manager) ─────────────────────────────────────────────
INFISICAL_TOKEN=st.dev.xxxxxxxxxxxxxxxxxxxx
INFISICAL_SITE_URL=http://infisical:8080

# ─── Internal service auth ───────────────────────────────────────────────────
INTERNAL_SERVICE_TOKEN=internal-service-token-change-me

# ─── Encryption ──────────────────────────────────────────────────────────────
CARD_ENCRYPTION_KEY_VERSION=1
# Base64-encoded 32-byte AES key — generate with: python -c "import os,base64; print(base64.b64encode(os.urandom(32)).decode())"
CARD_ENCRYPTION_KEY_V1=REPLACE_WITH_BASE64_32_BYTE_KEY

# ─── Acquirer ────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
ACQUIRER_MODE=mock    # mock | razorpay

# ─── UPI ─────────────────────────────────────────────────────────────────────
UPI_MODE=mock         # mock | live
GATEWAY_VPA=merchant@hdfc
NPCI_CALLBACK_SECRET=npci-hmac-secret-change-me

# ─── Email ───────────────────────────────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxx
EMAIL_FROM=noreply@payments.example.com
EMAIL_FROM_NAME=Payment Gateway

# ─── SMS ─────────────────────────────────────────────────────────────────────
FAST2SMS_API_KEY=xxxxxxxxxxxxxxxxxxxxxx

# ─── Storage (S3 / R2) ───────────────────────────────────────────────────────
AWS_REGION=ap-south-1
S3_KYC_BUCKET=payment-kyc-docs-dev
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
S3_ENDPOINT_URL=                # Leave empty for real AWS; set for R2/MinIO

# ─── Security ────────────────────────────────────────────────────────────────
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
SECRET_KEY=super-secret-key-change-in-production

# ─── Monitoring ──────────────────────────────────────────────────────────────
GRAFANA_ADMIN_PASSWORD=admin
GLITCHTIP_DSN=                  # Your GlitchTip/Sentry DSN
GITHUB_USERNAME=your-github-username
DOMAIN=localhost                 # Production: api.yourdomain.com
ACME_EMAIL=admin@yourdomain.com  # Let's Encrypt email

# ─── Celery ──────────────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
